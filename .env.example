# Browser-visible API base URL.
# Keep it same-origin in production (reverse proxy /api -> backend).
# NEVER put backend secrets (for example X-Dataset-Export-Key) in this file.
VITE_API_BASE_URL=/api

# Dev-server only: where Vite proxies /api during `npm run dev`.
# Not exposed to the browser bundle.
API_PROXY_TARGET=http://localhost:8080
